# Copia este archivo como .env y completa tus datos.
# El .env real NO se sube a GitHub: está en .gitignore.

# Tu base de datos local de PostgreSQL (usuario, clave y nombre de la base)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/biblioteca

# Puerto donde corre la app: http://localhost:5000
PUERTO=5000
